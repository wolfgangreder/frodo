<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Fix FroGpioAssignment_SEQ increment to match Hibernate allocation size.
    
    Original changeset created sequence with default increment=1.
    Hibernate uses allocation size=50 (default for @GeneratedValue).
    This causes schema validation error on startup.
  -->

  <changeSet id="25" author="frodo">
    <comment>Fix FroGpioAssignment_SEQ increment to 50 for Hibernate compatibility</comment>
    
    <sql dbms="firebird">
      ALTER SEQUENCE FroGpioAssignment_SEQ RESTART WITH 1 INCREMENT BY 50
    </sql>
  </changeSet>

</databaseChangeLog>
