<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Rename all database objects with "Fro" prefix to support integration
    into pre-existing databases without schema support.
    
    Naming convention:
    - Tables: FroModbusDevice, FroModbusDeviceInfo
    - Sequences: FroModbusDevice_SEQ, FroModbusDeviceInfo_SEQ
    - Indexes: idx_FroModbusDevice_enabled, idx_FroModbusDeviceInfo_last_read
    - Constraints: uk_FroDevice_connection, fk_FroDeviceInfo_device, etc.
  -->

  <changeSet id="4" author="frodo">
    <comment>Rename sequences with Fro prefix</comment>
    
    <!-- Firebird doesn't have ALTER SEQUENCE RENAME, so we need to drop and recreate -->
    <sql>CREATE SEQUENCE FroModbusDevice_SEQ START WITH 1 INCREMENT BY 50</sql>
    <sql>CREATE SEQUENCE FroModbusDeviceInfo_SEQ START WITH 1 INCREMENT BY 50</sql>
    
    <!-- Copy current sequence values if they exist -->
    <sql>
      EXECUTE BLOCK AS
      DECLARE VARIABLE current_val BIGINT;
      BEGIN
        SELECT GEN_ID(modbus_device_SEQ, 0) FROM RDB$DATABASE INTO :current_val;
        IF (current_val > 0) THEN
          EXECUTE STATEMENT 'ALTER SEQUENCE FroModbusDevice_SEQ RESTART WITH ' || (:current_val + 50);
      END
    </sql>
    <sql>
      EXECUTE BLOCK AS
      DECLARE VARIABLE current_val BIGINT;
      BEGIN
        SELECT GEN_ID(modbus_device_info_SEQ, 0) FROM RDB$DATABASE INTO :current_val;
        IF (current_val > 0) THEN
          EXECUTE STATEMENT 'ALTER SEQUENCE FroModbusDeviceInfo_SEQ RESTART WITH ' || (:current_val + 50);
      END
    </sql>
    
    <!-- Drop old sequences -->
    <sql>DROP SEQUENCE modbus_device_SEQ</sql>
    <sql>DROP SEQUENCE modbus_device_info_SEQ</sql>
  </changeSet>

  <changeSet id="5" author="frodo">
    <comment>Rename modbus_device_info table and its constraints/indexes</comment>
    
    <!-- Drop existing constraints and indexes before renaming -->
    <dropIndex indexName="idx_device_info_last_read" tableName="modbus_device_info"/>
    <dropUniqueConstraint tableName="modbus_device_info" constraintName="uk_device_info_device"/>
    <dropForeignKeyConstraint baseTableName="modbus_device_info" constraintName="fk_device_info_device"/>
    
    <!-- Rename table -->
    <renameTable oldTableName="modbus_device_info" newTableName="FroModbusDeviceInfo"/>
    
    <!-- Recreate foreign key with new name -->
    <addForeignKeyConstraint
        baseTableName="FroModbusDeviceInfo"
        baseColumnNames="device_id"
        referencedTableName="modbus_device"
        referencedColumnNames="id"
        constraintName="fk_FroDeviceInfo_device"
        onDelete="CASCADE"/>
    
    <!-- Recreate unique constraint with new name -->
    <addUniqueConstraint
        tableName="FroModbusDeviceInfo"
        columnNames="device_id"
        constraintName="uk_FroDeviceInfo_device"/>
    
    <!-- Recreate index with new name -->
    <createIndex indexName="idx_FroModbusDeviceInfo_last_read" tableName="FroModbusDeviceInfo">
      <column name="last_read_at"/>
    </createIndex>
  </changeSet>

  <changeSet id="6" author="frodo">
    <comment>Rename modbus_device table and its constraints/indexes</comment>
    
    <!-- Drop existing constraints and indexes before renaming -->
    <dropIndex indexName="idx_device_enabled" tableName="modbus_device"/>
    <dropUniqueConstraint tableName="modbus_device" constraintName="uk_device_connection"/>
    <sql>ALTER TABLE modbus_device DROP CONSTRAINT ck_port_range</sql>
    <sql>ALTER TABLE modbus_device DROP CONSTRAINT ck_unit_id_range</sql>
    
    <!-- Update foreign key reference from FroModbusDeviceInfo before renaming parent table -->
    <dropForeignKeyConstraint baseTableName="FroModbusDeviceInfo" constraintName="fk_FroDeviceInfo_device"/>
    
    <!-- Rename table -->
    <renameTable oldTableName="modbus_device" newTableName="FroModbusDevice"/>
    
    <!-- Recreate foreign key with new table reference -->
    <addForeignKeyConstraint
        baseTableName="FroModbusDeviceInfo"
        baseColumnNames="device_id"
        referencedTableName="FroModbusDevice"
        referencedColumnNames="id"
        constraintName="fk_FroDeviceInfo_device"
        onDelete="CASCADE"/>
    
    <!-- Recreate unique constraint with new name -->
    <addUniqueConstraint
        tableName="FroModbusDevice"
        columnNames="host, port, unit_id"
        constraintName="uk_FroDevice_connection"/>
    
    <!-- Recreate check constraints with new names -->
    <sql>ALTER TABLE FroModbusDevice ADD CONSTRAINT ck_FroDevice_port_range CHECK (port BETWEEN 1 AND 65535)</sql>
    <sql>ALTER TABLE FroModbusDevice ADD CONSTRAINT ck_FroDevice_unit_id_range CHECK (unit_id BETWEEN 1 AND 247)</sql>
    
    <!-- Recreate index with new name -->
    <createIndex indexName="idx_FroModbusDevice_enabled" tableName="FroModbusDevice">
      <column name="enabled"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
