<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Prerequisites:
    - Firebird database must be created with UTF-8 character set and 32K page size
    - CREATE DATABASE 'frodo.fdb' PAGE_SIZE 32768 DEFAULT CHARACTER SET UTF8
    - See docs/DATABASE_SETUP.md for complete setup instructions
  -->

  <changeSet id="1" author="frodo">
    <comment>Create FroModbusDevice table for device configurations</comment>

    <createTable tableName="FroModbusDevice">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="host" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="port" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="unit_id" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
        <constraints nullable="false"/>
      </column>
      <column name="description" type="VARCHAR(1000)"/>
      <column name="connection_timeout_seconds" type="INTEGER" defaultValueNumeric="30"/>
      <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addUniqueConstraint
        tableName="FroModbusDevice"
        columnNames="host, port, unit_id"
        constraintName="uk_FroDevice_connection"/>

    <sql>ALTER TABLE FroModbusDevice ADD CONSTRAINT ck_FroDevice_port_range CHECK (port BETWEEN 1 AND 65535)</sql>
    <sql>ALTER TABLE FroModbusDevice ADD CONSTRAINT ck_FroDevice_unit_id_range CHECK (unit_id BETWEEN 1 AND 247)</sql>

    <createIndex indexName="idx_FroModbusDevice_enabled" tableName="FroModbusDevice">
      <column name="enabled"/>
    </createIndex>
  </changeSet>

  <changeSet id="2" author="frodo">
    <comment>Create FroModbusDeviceInfo table for device identification cache</comment>

    <createTable tableName="FroModbusDeviceInfo">
      <column name="id" type="BIGINT">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="device_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="vendor_name" type="VARCHAR(255)"/>
      <column name="product_code" type="VARCHAR(255)"/>
      <column name="revision" type="VARCHAR(255)"/>
      <column name="vendor_url" type="VARCHAR(500)"/>
      <column name="product_name" type="VARCHAR(255)"/>
      <column name="model_name" type="VARCHAR(255)"/>
      <column name="user_app_name" type="VARCHAR(255)"/>
      <column name="conformity_level" type="INTEGER"/>
      <column name="last_read_at" type="TIMESTAMP"/>
      <column name="last_read_success" type="BOOLEAN"/>
      <column name="last_error_message" type="VARCHAR(1000)"/>
      <column name="read_attempt_count" type="INTEGER" defaultValueNumeric="0"/>
      <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
        baseTableName="FroModbusDeviceInfo"
        baseColumnNames="device_id"
        referencedTableName="FroModbusDevice"
        referencedColumnNames="id"
        constraintName="fk_FroDeviceInfo_device"
        onDelete="CASCADE"/>

    <addUniqueConstraint
        tableName="FroModbusDeviceInfo"
        columnNames="device_id"
        constraintName="uk_FroDeviceInfo_device"/>

    <createIndex indexName="idx_FroModbusDeviceInfo_last_read" tableName="FroModbusDeviceInfo">
      <column name="last_read_at"/>
    </createIndex>
  </changeSet>

  <changeSet id="3" author="frodo">
    <comment>Create sequences for Hibernate identity generation (Firebird does not support autoincrement)</comment>

    <sql>CREATE SEQUENCE FroModbusDevice_SEQ START WITH 1 INCREMENT BY 50</sql>
    <sql>CREATE SEQUENCE FroModbusDeviceInfo_SEQ START WITH 1 INCREMENT BY 50</sql>
  </changeSet>

</databaseChangeLog>
