      "baseUnit": "watts",
      "type": "gauge",
      "category": "power",
      "fields": [
        { "modelIds": [101, 102, 103, 111, 112, 113], "field": "W" }
      ]
    },
    {
      "metricName": "frodo_sunspec_ac_current_amperes",
