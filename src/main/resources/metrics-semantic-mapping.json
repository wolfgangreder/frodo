{
  "version": "1.0.0",
  "description": "Maps SunSpec model fields to semantic Prometheus metric names with ISO base units",
  "unitMapping": {
    "W": { "baseUnit": "watts", "symbol": "W", "quantity": "power" },
    "VA": { "baseUnit": "voltamperes", "symbol": "VA", "quantity": "apparent power" },
    "var": { "baseUnit": "vars", "symbol": "var", "quantity": "reactive power" },
    "Wh": { "baseUnit": "watt_hours", "symbol": "Wh", "quantity": "energy" },
    "VAh": { "baseUnit": "voltampere_hours", "symbol": "VAh", "quantity": "apparent energy" },
    "varh": { "baseUnit": "var_hours", "symbol": "varh", "quantity": "reactive energy" },
    "A": { "baseUnit": "amperes", "symbol": "A", "quantity": "current" },
    "V": { "baseUnit": "volts", "symbol": "V", "quantity": "voltage" },
    "Hz": { "baseUnit": "hertz", "symbol": "Hz", "quantity": "frequency" },
    "C": { "baseUnit": "celsius", "symbol": "°C", "quantity": "temperature" },
    "Pct": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "cos()": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "ohms": { "baseUnit": "ohms", "symbol": "Ω", "quantity": "resistance" },
    "AH": { "baseUnit": "ampere_hours", "symbol": "Ah", "quantity": "capacity" },
    "Secs": { "baseUnit": "seconds", "symbol": "s", "quantity": "time" },
    "% WMax": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "% VArMax": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "% WChaMax": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "% AhrRtg": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "% WMax/sec": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "% WChaMax/sec": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "% WGra": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" },
    "% VArAval": { "baseUnit": "ratio", "symbol": "", "quantity": "ratio" }
  },
  "metrics": [
    {
      "metricName": "frodo_sunspec_ac_power_watts",
