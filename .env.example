# Frodo Docker environment configuration
# Copy to .env and customize for your system:  cp .env.example .env

# GPIO group ID for Docker container (RPi5 GPIO access)
# Find with:  getent group gpio | cut -d: -f3
# Or check:   ls -l /dev/gpiochip0
# Common values: 997 (gpio), 20 (dialout)
GPIO_GROUP_ID=997
